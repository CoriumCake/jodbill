# =====================================================================
# jodbill (จดบิล) - Environment Configuration
# =====================================================================

# 1. Supabase (Google Auth & Real-time Postgres Database)
# สามารถดูได้ที่ Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# 2. (Optional) Standalone Google OAuth 2.0 Client ID
VITE_GOOGLE_CLIENT_ID=

# 3. (Optional) Google Gemini API Key for Vision OCR
# บันทึกเป็น Secret บน Vercel หรือใน .env ป้องกันคีย์หลุดไปหน้าเว็บ
GEMINI_API_KEY=


# =====================================================================
# jodbill (จดบิล) - Environment Configuration
# =====================================================================

# 1. Supabase (Recommended for Google Auth & Real-time Postgres Database)
# ได้รับจาก: https://supabase.com/dashboard > Project Settings > API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# 2. Google OAuth 2.0 Client ID (Alternative direct Google popup)
# สร้างได้ฟรีที่: https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=

# 3. (Optional) Google Gemini API Key for Vision OCR
VITE_GEMINI_API_KEY=
